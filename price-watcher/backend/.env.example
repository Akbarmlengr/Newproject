# Server
PORT=4000

# eBay Browse API (https://developer.ebay.com/my/keys)
# Create a "Production" keyset, then generate an OAuth app token via the
# client-credentials flow. We only need the client ID/secret here; the
# backend fetches and caches its own access token.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# How often to re-check prices (cron expression). Default: every 6 hours.
POLL_CRON=0 */6 * * *

# Email alerts (SMTP). For Gmail, use an App Password, not your normal password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
